# Pinned Go toolchain patch. Pin base-image digests before any production deployment.
FROM golang:1.27.3 AS build
WORKDIR /src
COPY go.mod ./
# go.sum is generated by go mod tidy; download first because it is not yet committed.
RUN go mod download
COPY . .
RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/webhook ./cmd/webhook

FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/webhook /webhook
ENV PORT=8080
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/webhook"]
