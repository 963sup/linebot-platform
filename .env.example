# Go HTTP service (safe values only)
PORT=8080

# Local sync mode uses both credentials; public Cloud Run durable mode
# accepts only the signing secret, never the LINE access token.
LINE_EVENT_MODE=sync
LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=  # local sync or private worker only

# Optional SDK integrations: not yet active in the runtime.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
