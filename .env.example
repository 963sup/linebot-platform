# Copy only non-sensitive values to the runtime environment.
# This file documents all runtime keys; the binary does NOT read .env automatically.
# Local development remains credential-free by default. Cloud Run injects Secrets
# from Secret Manager separately into the public webhook and private worker.
APP_ENV=local
PORT=8080
LINE_EVENT_MODE=sync
LINE_API_TIMEOUT=8s
LOG_LEVEL=info
LOG_FORMAT=text

# Secrets: keep these empty in this file. For local sync testing, supply both
# through your secure shell. In Cloud Run, public receives only the Channel
# Secret and private receives only the Channel Access Token.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Durable Cloud Run settings (public webhook and private worker).
LINE_BOT_DESTINATION=U31469a4d9b5533208c71199a43b47803
GCP_PROJECT_ID=bubbly-area-513305-s0
TASK_QUEUE_NAME=projects/bubbly-area-513305-s0/locations/asia-east1/queues/line-bot-events
TASK_WORKER_URL=https://line-bot-private-185354881750.asia-east1.run.app/tasks/line-reply
TASK_OIDC_AUDIENCE=https://line-bot-private-185354881750.asia-east1.run.app
TASK_INVOKER_EMAIL=line-bot-scheduler@bubbly-area-513305-s0.iam.gserviceaccount.com

# Platform-provided Cloud Run service marker. Do not set this locally.
K_SERVICE=

# Read-only ops command target; required only for `ops events` in staging.
LINEBOT_STAGING_PROJECT=
