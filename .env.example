# Local-only safe defaults. The binary does NOT read this file automatically.
# Cloud Run receives production settings from cloudbuild.deploy.yaml.
APP_ENV=local
PORT=8080
LINE_EVENT_MODE=sync
LINE_API_TIMEOUT=8s
LOG_LEVEL=info
LOG_FORMAT=text
TELEMETRY_MODE=off
OTEL_TRACE_SAMPLE_RATIO=0.05
OTEL_METRIC_INTERVAL=60s

# Never place credential values in this file. For local sync testing, supply
# both values only through a secure shell. In Cloud Run, Secret Manager injects
# the Channel Secret into public and the Access Token into private.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# `K_SERVICE` is supplied by Cloud Run and must not be set locally.
# `LINEBOT_STAGING_PROJECT` is only required by the separately authorized
# staging-only `ops events` command; set it in the invoking shell when needed.
