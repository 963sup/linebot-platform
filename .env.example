# Local-only safe defaults. The binary does NOT read this file automatically.
# Cloud Run receives production settings from cloudbuild.deploy.yaml.
APP_ENV=local
PORT=8080
LINE_EVENT_MODE=durable
LINE_API_TIMEOUT=8s
LOG_LEVEL=info
LOG_FORMAT=text
TELEMETRY_MODE=off
OTEL_TRACE_SAMPLE_RATIO=0.05
OTEL_METRIC_INTERVAL=60s

# Never place credential values in this file. Webhook only receives the
# Channel Secret; worker only receives the Access Token, including locally.
# A live webhook also requires the Firestore and Cloud Tasks settings.
LINE_MESSAGING_API_CHANNEL_SECRET=
LINE_MESSAGING_API_CHANNEL_ACCESS_TOKEN=

# Optional webhook reply entry. Local development permits loopback HTTP;
# LINE MINI App values come from Basic settings and Web app settings.

# Public Mini App identifiers are blank in the webhook example.
LINE_MINI_APP_CHANNEL_ID=
LINE_MINI_APP_LIFF_URL=https://miniapp.line.me/REPLACE_LIFF_ID
LINE_MINI_APP_ENDPOINT_URL=
GCP_PROJECT_ID=

# `K_SERVICE` is supplied by Cloud Run and must not be set locally.
# `LINEBOT_STAGING_PROJECT` is only required by the separately authorized
# staging-only `ops events` command; set it in the invoking shell when needed.
