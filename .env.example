# Copy only non-sensitive keys to the runtime environment.
# This file is documentation; the binary does NOT read .env automatically.
APP_ENV=local
PORT=8080
LINE_EVENT_MODE=sync
LINE_API_TIMEOUT=8s
LOG_LEVEL=info
LOG_FORMAT=text

# Empty placeholders only. Keep real credentials outside Git.
# For local sync testing, supply both in your secure shell/environment.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Durable-only ordinary settings are documented in
# docs/operations/configuration.md. Never put real token values in this file.
