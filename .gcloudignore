# Used by gcloud builds submit to prepare source context.
.gcloudignore
.git
.gitignore
#!include:.gitignore

# Non-runtime project material is omitted from Cloud Build source uploads.
.github/
.agents/
.codex/
.vscode/
docs/
deploy/
plugins/
.env.example

# Keep Dockerfile, go.mod, go.sum, cmd/, internal/ and tests/.
# Never include secrets, local credentials, Terraform state or git history.
