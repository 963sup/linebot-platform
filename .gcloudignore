# Used by gcloud builds submit to prepare source context.
.gcloudignore
.git
.gitignore
#!include:.gitignore

# Non-runtime project material is omitted from Cloud Build source uploads.
.github/
.agents/
.vscode/
deploy/
plugins/

# Architecture link tests run inside Cloud Build. Re-include only the tracked
# documentation targets they resolve, not the rest of these non-runtime trees.
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/sdk-integration/
!.agents/skills/sdk-integration/SKILL.md
!.agents/skills/agent-tool-preflight/
!.agents/skills/agent-tool-preflight/SKILL.md
!.agents/skills/graphify/
!.agents/skills/graphify/SKILL.md
!.agents/skills/repomix-reference/
!.agents/skills/repomix-reference/SKILL.md
!deploy/
deploy/*
!deploy/firestore/
!deploy/firestore/README.md

# Keep Dockerfile, go.mod, go.sum, cmd/, internal/ and tests/.
# Never include secrets, local credentials, Terraform state or git history.
