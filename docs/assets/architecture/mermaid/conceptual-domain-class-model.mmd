classDiagram
    direction LR
    namespace Identity {
        class ExternalIdentity {
            +provider
            +providerSubject
            +userId
        }
        class Session {
            +sessionId
            +userId
            +expiresAt
        }
    }
    namespace Account {
        class User {
            +userId
            +status
        }
        class Enterprise {
            +enterpriseId
            +name
        }
        class Organization {
            +organizationId
            +name
        }
    }
    namespace Team {
        class EnterpriseTeam {
            +teamId
            +enterpriseId
        }
        class OrganizationTeam {
            +teamId
            +organizationId
        }
    }
    namespace Membership {
        class EnterpriseMembership {
            +userId
            +enterpriseId
            +status
        }
        class OrganizationMembership {
            +userId
            +organizationId
            +status
        }
        class TeamMembership {
            +userId
            +teamId
            +status
        }
    }
    namespace Access {
        class Role {
            +roleId
            +name
        }
        class Permission {
            +permissionId
            +action
            +resource
        }
        class RoleAssignment {
            +assignmentId
            +userId
            +roleId
            +scopeId
        }
        class Scope {
            <<Entity>>
            +scopeKind
            +scopeId
        }
    }
    namespace Attendance {
        class AttendanceSession {
            +attendanceSessionId
            +userId
            +scopeId
            +checkedInAt
            +checkedOutAt
            +CheckIn()
            +CheckOut()
        }
        class AttendancePolicy {
            +CanCheckIn()
            +CanCheckOut()
        }
        class Location {
            <<ValueObject>>
            +latitude
            +longitude
            +accuracy
            +capturedAt
        }
    }
    namespace Timekeeping {
        class TimeEntry {
            +timeEntryId
            +userId
            +startedAt
            +endedAt
        }
        class Timesheet {
            +timesheetId
            +userId
            +periodStart
            +periodEnd
            +AddEntry()
        }
    }
    User "1" --> "0..*" ExternalIdentity : maps
    User "1" --> "0..*" Session : authenticates
    Enterprise "0..1" --> "0..*" Organization : manages
    Enterprise "1" --> "0..*" EnterpriseTeam : owns
    Organization "1" --> "0..*" OrganizationTeam : owns
    User "1" --> "0..*" EnterpriseMembership : joins
    Enterprise "1" --> "0..*" EnterpriseMembership : has
    User "1" --> "0..*" OrganizationMembership : joins
    Organization "1" --> "0..*" OrganizationMembership : has
    User "1" --> "0..*" TeamMembership : joins
    TeamMembership --> EnterpriseTeam : targetIfEnterprise
    TeamMembership --> OrganizationTeam : targetIfOrganization
    User "1" --> "0..*" RoleAssignment : receives
    Role "1" --> "0..*" RoleAssignment : assigned
    Role "0..*" -- "0..*" Permission : grants
    RoleAssignment --> Scope : constrainedBy
    User "1" --> "0..*" AttendanceSession : records
    AttendanceSession --> Scope : occurredIn
    AttendanceSession --> Location : captures
    AttendancePolicy ..> AttendanceSession : validates
    User "1" --> "0..*" TimeEntry : reports
    TimeEntry --> AttendanceSession : mayReference
    Timesheet "1" o-- "0..*" TimeEntry : aggregates
    User "1" --> "0..*" Timesheet : owns
