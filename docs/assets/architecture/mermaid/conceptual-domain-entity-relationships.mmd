        string team_id PK, FK
        string organization_id FK
    }
    ENTERPRISE_MEMBERSHIP {
        string enterprise_membership_id PK
        string user_id FK
        string enterprise_id FK
        string status
    }
    ORGANIZATION_MEMBERSHIP {
        string organization_membership_id PK
        string user_id FK
        string organization_id FK
        string status
    }
    TEAM_MEMBERSHIP {
        string team_membership_id PK
        string user_id FK
        string team_id FK
        string status
    }
